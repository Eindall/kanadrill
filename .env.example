# ---------- Production (docker-compose.yml) ----------
# Copie ce fichier en `.env` et remplis les valeurs. Ne commite jamais `.env`.

# Base PostgreSQL. Choisis un mot de passe sans caractères spéciaux (il est inséré dans une URL) : `openssl rand -hex 24`
POSTGRES_USER=kanadrill
POSTGRES_PASSWORD=
POSTGRES_DB=kanadrill

# Signature des sessions (32 caractères minimum) : `openssl rand -hex 32`
JWT_SECRET=

# URL publique de l'application, sans slash final (sert aussi à construire l'URL de retour OAuth).
APP_URL=https://kana.example.com

# `true` derrière HTTPS (production). Mets `false` uniquement en développement local en HTTP.
COOKIE_SECURE=true

# Application Discord (https://discord.com/developers/applications) : OAuth2 → Client ID / Client Secret.
# Ajoute `${APP_URL}/api/auth/discord/callback` dans OAuth2 → Redirects.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Application Gmail
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Clé de hachage pour les emails (32 caractères minimum) : `openssl rand -hex 32`
EMAIL_HASH_KEY=

# Fuseau horaire qui définit le « jour » des révisions (objectif quotidien de cartes tentées). Facultatif.
# APP_TIMEZONE=Europe/Paris

# Dossier des données PostgreSQL sur l'hôte (chemin absolu). Sans cette variable : volume Docker nommé.
DB_DATA_DIR=/home/tong/data/kanadrill/postgres

# Nom du réseau Docker partagé avec Caddy.
PROXY_NETWORK=


# ---------- Développement local (npm run dev:api) ----------
# Pour développer, mets plutôt ceci dans ton `.env` (la base vient de docker-compose.dev.yml) :
#
# DATABASE_URL=postgres://kanadrill:devpass@127.0.0.1:5432/kanadrill
# JWT_SECRET=<32 caractères minimum>
# APP_URL=http://localhost:4200
# COOKIE_SECURE=false
# DISCORD_CLIENT_ID=...
# DISCORD_CLIENT_SECRET=...
# DISCORD_REDIRECT_URI=http://localhost:4200/api/auth/discord/callback
