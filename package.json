{
  "name": "kanadrill",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev:api": "nx serve api",
    "dev:web": "nx serve web",
    "build": "nx run-many -t build -p api web",
    "test": "nx run-many -t test",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "migration:generate": "cross-env TS_NODE_PROJECT=apps/api/tsconfig.app.json typeorm-ts-node-commonjs migration:generate -d apps/api/src/app/database/data-source.ts",
    "migration:run": "cross-env TS_NODE_PROJECT=apps/api/tsconfig.app.json typeorm-ts-node-commonjs migration:run -d apps/api/src/app/database/data-source.ts",
    "migration:revert": "cross-env TS_NODE_PROJECT=apps/api/tsconfig.app.json typeorm-ts-node-commonjs migration:revert -d apps/api/src/app/database/data-source.ts"
  },
  "private": true,
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "~2.6.0",
    "@analogjs/vitest-angular": "~2.6.0",
    "@angular-devkit/core": "~22.1.0",
